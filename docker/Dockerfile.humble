FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

SHELL ["/bin/bash", "-c"]

# Install locale and basic system utilities
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    ca-certificates \
    software-properties-common \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Add the official ROS 2 apt repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
    > /etc/apt/sources.list.d/ros2.list

# Install ROS 2 Humble, development tools, and hardware-related utilities
RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-ament-cmake-auto \
    ros-humble-camera-info-manager \
    ros-humble-camera-calibration-parsers \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-image-transport-plugins \
    ros-humble-compressed-image-transport \
    ros-humble-image-view \
    ros-humble-mavros \
    ros-humble-mavros-extras \
    ros-humble-rclcpp-components \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-rosbag2-transport \
    ros-humble-rqt \
    ros-humble-rqt-graph \
    ros-humble-rqt-image-view \
    ros-humble-rosidl-default-generators \
    python3-pip \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-numpy \
    python3-matplotlib \
    build-essential \
    cmake \
    ffmpeg \
    geographiclib-tools \
    git \
    libavcodec-dev \
    libavutil-dev \
    libopencv-dev \
    libswscale-dev \
    libxcb-xinerama0 \
    libxcb-cursor0 \
    libxkbcommon-x11-0 \
    libgl1-mesa-glx \
    libegl1 \
    vim \
    nano \
    python3-pydantic \
    swig \
    pkg-config \
    usbutils \
    v4l-utils \
    net-tools \
    iputils-ping \
    lsof \
    && rm -rf /var/lib/apt/lists/*

RUN /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh

# Initialize rosdep if it has not already been initialized
RUN rosdep init || true

# Install Python dependencies for MAVLink and serial communication
RUN pip3 install --no-cache-dir \
    google-genai \
    pillow \
    pymavlink \
    pyserial

# Set the default workspace directory
WORKDIR /workspace/uav-autopilot

# Configure ROS 2 workspace setup
RUN echo '' >> /root/.bashrc && \
    echo '# ROS 2 workspace setup' >> /root/.bashrc && \
    echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc && \
    echo 'if [ -f /workspace/uav-autopilot/ros2_ws/install/setup.bash ]; then source /workspace/uav-autopilot/ros2_ws/install/setup.bash; fi' >> /root/.bashrc && \
    echo 'alias uavws="cd /workspace/uav-autopilot/ros2_ws"' >> /root/.bashrc && \
    echo 'alias uavsrc="source /workspace/uav-autopilot/ros2_ws/install/setup.bash"' >> /root/.bashrc && \
    echo 'alias uavbuild="cd /workspace/uav-autopilot/ros2_ws && colcon build --symlink-install && source install/setup.bash"' >> /root/.bashrc
